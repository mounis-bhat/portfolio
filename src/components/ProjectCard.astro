---
import type { CollectionEntry } from 'astro:content';
import ProjectTile from './ProjectTile.astro';

interface Props {
  project: CollectionEntry<'works'>;
}

const { project } = Astro.props;
const { id, data } = project;
const source = data.github ? 'Source' : data.url ? 'Live' : null;
---

<a href={`/works/${id}`} class="project-card">
  <ProjectTile
    id={id}
    title={data.title}
    category={data.category}
    tags={data.tags}
    image={data.image}
  />

  <div class="project-card__body">
    <div class="project-card__meta">
      {data.year && <span class="project-card__year">{data.year}</span>}
      {data.category && (
        <>
          <span class="project-card__dot" aria-hidden="true">·</span>
          <span class="project-card__cat">{data.category}</span>
        </>
      )}
      {source && <span class="project-card__source">{source}</span>}
    </div>

    <h3 class="project-card__title" transition:name={`project-title-${id}`}>
      {data.title}
    </h3>

    <p class="project-card__desc">{data.description}</p>
  </div>

  <span class="project-card__arrow" aria-hidden="true">→</span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    position: relative;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  /* Teal gradient shimmer — slides in on hover */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(136, 204, 202, 0.08) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
    z-index: 1;
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  /* Subtle zoom on the generated tile when hovering */
  .project-card :global(.ptile__art),
  .project-card :global(.ptile > img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .project-card:hover :global(.ptile__art),
  .project-card:hover :global(.ptile > img) {
    transform: scale(1.04);
  }

  /* Body */
  .project-card__body {
    padding: var(--space-5);
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .project-card__year {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .project-card__dot {
    color: var(--text-faint);
  }

  .project-card__cat {
    color: var(--text-muted);
  }

  .project-card__source {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--accent-strong);
    background-color: var(--accent-dim);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    color: var(--text);
    line-height: 1.3;
  }

  .project-card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Arrow */
  .project-card__arrow {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-5);
    z-index: 2;
    font-size: var(--text-sm);
    color: var(--text-faint);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .project-card:hover .project-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
